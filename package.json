{
  "name": "@data-fair/processing-gbfs",
  "version": "0.1.0",
  "description": "Load GBFS data into data-fair datasets",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "build-types": "export NODE_OPTIONS='--experimental-strip-types' && df-build-types ./",
    "test-base": "NODE_ENV=test node --experimental-strip-types --test-force-exit --test-concurrency=1 --test --test-reporter=spec --test-reporter-destination=stdout",
    "test": "npm run test-base test-it/*.ts"
  },
  "imports": {
    "#config": "./lib/config.ts",
    "#types/*": "./types/*"
  },
  "files": [
    "processing-config-schema.json",
    "./index.ts",
    "./lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/processing-gbfs.git"
  },
  "keywords": [
    "data-fair-processings-plugin"
  ],
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/processing-gbfs/issues"
  },
  "homepage": "https://github.com/data-fair/processing-gbfs#readme",
  "dependencies": {
    "form-data": "^4.0.0",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/lib-common-types": "^1.20.6",
    "@data-fair/lib-processing-dev": "^0.3.0",
    "@data-fair/lib-types-builder": "^1.7.0",
    "@data-fair/lib-utils": "^1.11.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "config": "^4.4.1",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "neostandard": "^0.12.1",
    "typescript": "^5.8.3",
    "ws": "^8.19.0"
  }
}
